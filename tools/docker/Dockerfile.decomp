# The F-Zero X decomp's build (lib/fzerox's README, "Install build dependencies"): Ubuntu 24.04 (its spimdisasm needs
# a newer Python than 22.04 has), its packages, its Python requirements, and what Torch (its asset extractor, a CMake
# project) needs to build.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        binutils-mips-linux-gnu \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libpng-dev \
        make \
        ninja-build \
        pkgconf \
        python3 \
        python3-pip \
        wget \
        zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*
COPY requirements-python.txt /tmp/
RUN python3 -m pip install --no-cache-dir --break-system-packages -r /tmp/requirements-python.txt
